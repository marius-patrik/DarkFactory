{
  "version": 1,
  "site": {
    "name": "DarkFactory",
    "description": "Autonomous, governed software delivery built around a self-hosting df engine, versioned capabilities and GitHub as the durable control plane."
  },
  "home": "docs/home.md",
  "api": {
    "typescript": {
      "name": "DarkFactory API",
      "entryPoints": [
        "packages/protocol/src/index.ts",
        "packages/core/src/index.ts",
        "packages/capability/src/index.ts",
        "packages/capability/src/loader.ts",
        "packages/github/src/index.ts",
        "packages/github/src/node.ts",
        "packages/keychain/src/index.ts",
        "packages/auth/src/index.ts",
        "packages/docs/src/index.ts",
        "packages/cli/src/index.ts",
        "packages/web/src/index.ts",
        "capabilities/code/capability.ts",
        "capabilities/paper/capability.ts",
        "capabilities/math/capability.ts"
      ],
      "tsconfig": "harness/tsconfig.json"
    }
  }
}
