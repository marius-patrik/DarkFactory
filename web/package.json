{
  "name": "darkfactory-paper-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "lint": "biome lint src rsbuild.config.ts",
    "format": "biome format --write src rsbuild.config.ts package.json tsconfig.json biome.json components.json",
    "format:check": "biome format src rsbuild.config.ts package.json tsconfig.json biome.json components.json",
    "check": "biome lint src rsbuild.config.ts && tsc --noEmit && rsbuild build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@monaco-editor/react": "4.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-animated": "1.0.5",
    "lucide-react": "1.47.0",
    "monaco-editor": "0.56.0",
    "motion": "13.4.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@rsbuild/core": "2.2.8",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
