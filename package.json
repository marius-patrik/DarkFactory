{
  "name": "darkfactory-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "capabilities/*",
    "harness",
    "paper"
  ],
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "test": "bun run --cwd harness test",
    "typecheck": "bun run --cwd harness typecheck",
    "check": "bun run --cwd harness check && bun run paper:check",
    "docs": "bun scripts/build-docs.ts",
    "paper:dev": "bun run --cwd paper dev",
    "paper:publication": "bun run --cwd paper publication",
    "paper:check": "bun run --cwd paper check",
    "format:check": "BASE=\"${DF_BASE_SHA:-origin/darkfactory}\"; if git diff --name-only \"$BASE\" -- harness | grep -q .; then cd harness && bun x biome ci --changed --since=\"$BASE\" .; else echo \"No changed harness files\"; fi",
    "docs:check": "bun scripts/build-docs.ts --check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
