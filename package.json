{
  "name": "darkfactory-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "capabilities/*",
    "harness",
    "paper"
  ],
  "scripts": {
    "test": "bun run --cwd harness test",
    "typecheck": "bun run --cwd harness typecheck",
    "check": "bun run --cwd harness check",
    "docs": "bun scripts/build-docs.ts",
    "release:version": "bun scripts/versioning.ts",
    "release:targets": "bun harness/scripts/release-targets.ts",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
