#import "/DarkFactory/schema.typ": section

#let item = section(
  key: "change_lifecycle_intro",
  title: [Úvod],
  definition: terms => [
Životní cyklus změny popisuje, jak DarkFactory převádí trvalé zadání na řízenou změnu repozitáře a jak mezi jednotlivými fázemi zachovává schválený záměr a pozorovatelný stav.
  ],
  description: terms => [
Pořadí odděluje zadání a plán, provedení změny, její ověření a revizi, finalizaci a případné pokračování po přerušení. Jednotlivé mechanismy jsou zde popsány pouze v rozsahu specifickém pro tento tok; obecné pojmy z teoretické části se znovu nedefinují.
  ],
)
