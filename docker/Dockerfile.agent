# Containerized df CI Agent
# Provides full parity between local execution and GitHub Actions CI.

FROM python:3.12-slim-bookworm

LABEL maintainer="marius-patrik"
LABEL description="Containerized df agent environment with Python 3.12, Bun, dev tools, and GitHub CLI."

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 1. Install base utilities, D-Bus, Secret Service, unzip (for the Bun installer),
# and GitHub CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    unzip \
    ca-certificates \
    gnupg \
    dbus-x11 \
    gnome-keyring \
    libsecret-tools \
    tmux \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global --add safe.directory '*'

# 2. Install Bun (pinned), the runtime the df agent harness runs on
ARG BUN_VERSION=1.4.2
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash -s -- "bun-v${BUN_VERSION}" \
    && bun --version

# 3. Install the df agent harness, the pipeline's only agent harness.
#
# The runner resolves every agent call through the `df` binary, which owns model choice and
# in-flight failover across its own chain itself — external coding-agent CLIs are not installed.
# The harness source ships with the pipeline checkout (`packages/harness/`, landed separately), so
# it is copied in and its dependencies installed frozen. There is no compile step: df's assets
# resolve relative to the source tree, which the wrapper executes in place through Bun.
#
# `scripts/df-wrapper.sh` is the single owner of the `df` PATH contract for both
# staged layouts, so the image installs that wrapper rather than its own dispatcher and points
# DF_SOURCE at the source entrypoint. A staged local install puts a compiled `df-bin` beside the
# same wrapper instead, and needs no Bun at runtime.
# `capabilities/` moved to `.darkfactory/plugins/` in #1297 and `packages/harness/package.json`
# was deleted with the per-package manifests, so there is no directory and no sub-manifest left to
# copy or install into. `bun.lock` is copied because the root workspace is the install target now.
COPY package.json bun.lock /opt/darkfactory/
COPY packages/ /opt/darkfactory/packages/
COPY .darkfactory/ /opt/darkfactory/.darkfactory/
COPY tsconfig.base.json tsconfig.json /opt/darkfactory/
COPY scripts/ /opt/darkfactory/scripts/
RUN cd /opt/darkfactory && bun install --frozen-lockfile
# ENV, not a profile script: the runner invokes `df` from a constructed environment, so a value
# only a login shell reads would leave every agent call without a runtime to dispatch to.
ENV DF_SOURCE=/opt/darkfactory/packages/harness/src/cli.ts
RUN cp /opt/darkfactory/scripts/df-wrapper.sh /usr/local/bin/df \
    && chmod +x /usr/local/bin/df \
    && df providers >/dev/null

# Record which harness is present so the build log answers "what can this image drive?"
RUN set -eux; \
    echo "=== agent harness in this image ==="; \
    if command -v df >/dev/null 2>&1; then \
      echo "  present: df -> $(command -v df)"; \
    else \
      echo "  ABSENT:  df"; \
    fi

# 4. Project workspace
#
# `pyproject.toml` and `requirements-dev.txt` were deleted with the Python removal, so there is
# nothing to pip install. A consumer repository that brings its own Python ecosystem installs into
# this workspace at container start; the image itself no longer carries one.
WORKDIR /workspace

# 5. Create the unprivileged user the agent runs as
#
# PRD.md D4 states that agent processes execute with non-root privileges. The image had
# no USER directive, so they ran as root.
#
# uid 1001 matches the GitHub runner's own user, so the bind-mounted workspace is writable without
# relaxing its permissions.
ARG AGENT_UID=1001
ARG AGENT_GID=1001
RUN groupadd --gid ${AGENT_GID} agent \
    && useradd --uid ${AGENT_UID} --gid ${AGENT_GID} --create-home --shell /bin/bash agent \
    && mkdir -p /home/agent/.codex /home/agent/.grok /home/agent/.config \
    && chown -R agent:agent /home/agent /workspace

ENV HOME=/home/agent

# 6. The delivery workflows run in the runner context, not in this container, so the pipeline
# scripts that used to be copied here are not. `.github/scripts/` was deleted with the Python
# removal; the subagents are reached through `df` and `packages/harness/src/cli.ts` instead.

# Everything below runs unprivileged. Placed after the installs so package managers still have
# the root they need at build time.
USER agent

# The agent entrypoint is `df` — the CLI the image already installs a few lines above.
#
# Not a path into the source tree, and not a second executable. The image ships one command and runs
# it, so anything the agent image can do is something `df` can do: `docker run darkfactory-agent
# dispatch` appends `dispatch` to this entrypoint, and `df dispatch` runs it.
#
# The nine runner commands (dispatch, interpret, plan, implement, self-review, self-review-fix,
# plan-alignment, respond, token-refresh) are cases in `df`'s own switch, not a separate process. That
# is the point at which `nix/entrypoint.sh`'s blocker is satisfied: it refused to translate `dispatch`
# into `graph dispatch` because a shim printing a plan and exiting 0 turns a loud failure into a
# silent one. The answer was a real `df dispatch`, not a better shim.
#
# `dbus-run-session` still wraps it, because the credential store is a D-Bus client and dropping the
# wrapper removes the session bus rather than the dependency.
ENTRYPOINT ["dbus-run-session", "--", "df"]