{
  "repo": {
    "$comment": "Repository-specific declarations that DarkFactory cannot infer reliably.",
    "identity": {
      "owner": "marius-patrik",
      "repo": "agent-DarkFactory",
      "display_name": "DarkFactory",
      "project_title": "DarkFactory",
      "agent_slug": "darkfactory-agent",
      "default_branch": "main",
      "development_branch": "main",
      "description": "Self-hosting autonomous software delivery built around a declarable workflow graph, versioned capabilities and GitHub as the durable control plane.",
      "topics": [
        "agentic-coding",
        "agentic-development",
        "ai-agents",
        "autonomous-agents",
        "automation",
        "dark-factory",
        "developer-tools",
        "orchestration",
        "template",
        "template-repository",
        "workspace"
      ]
    },
    "protection": {
      "$comment": "Branch protection is declared here, not in the code that applies it. Every field the reconcile sends to GitHub is in this block, so the policy a reviewer reads is the policy that runs. A lane names its own branch rather than being a role, because which branch is the integration lane and which is the release lane is a fact about this repository and not about the pipeline.",
      "lanes": [
        {
          "branch": "main",
          "required_checks": [
            "quality",
            "verify-bound-issue"
          ],
          "approvals": 1,
          "enforce_admins": false,
          "strict": true,
          "resolve_conversations": true,
          "$comment": "The single lane. `develop` and `main` were two lanes with two gates; the integration branch was renamed onto `main`, so one branch carries the full gate. The release lane's weaker check (`main-source`) was dropped rather than merged: it asserted that a pull request into `main` came *from* `develop`, which cannot hold once there is no `develop`."
        }
      ]
    },
    "license": {
      "$comment": "The licence is declared here and the file is written from GitHub's canonical text, so it cannot drift from the wording it claims to be. `spdx` must be one of the identifiers licensing.OFFERED lists; NONE means deliberately not licensed for reuse, which is different from having forgotten to choose.",
      "spdx": "GPL-3.0",
      "holder": "Patrik Marius",
      "year": "2026"
    },
    "upstream": {
      "$comment": "DarkFactory is its own upstream; consumer installation/update uses released DarkFactory artifacts.",
      "repo": null,
      "ref": null
    },
    "versioning": {
      "mode": "zerover",
      "tag_prefix": "v",
      "initial": "0.287.0"
    },
    "environment": {
      "$comment": "No packages are declared. The repository is a TypeScript workspace, and its packages are resolved from the workspace layout rather than asserted here. The typst exemptions were removed with the paper: it moved to marius-patrik/DarkFactory-Paper, so this repository detects no typst package and an exemption naming an ecosystem no package belongs to is rejected when the contract loads.",
      "packages": [],
      "testing": {},
      "formatting": {},
      "release": {
        "$comment": "Release actions are declared per ecosystem. #360 enables the final first-party package/native/web release artifacts.",
        "python": {
          "enabled": false,
          "$comment": "pyproject.toml is tooling-only; DarkFactory does not publish a Python package."
        },
        "node": {
          "$comment": "Node package/native/web publishing is enabled by #360 when the final release surface is complete.",
          "enabled": false
        }
      },
      "setup": {}
    },
    "areas": {
      "$comment": "Area labels, commit scopes and agent routing all read this one list, so they cannot drift apart. Declaration order is match order - the first area whose keywords hit wins - so specific areas come before general ones. A consumer repository replaces this block wholesale with its own domains.",
      "$default": "ci",
      "agents": {
        "description": "Agent runtime, routing, providers, planning/review orchestration and model execution",
        "keywords": [
          "agent",
          "harness",
          "persona",
          "provider",
          "llm",
          "prompt",
          "approval",
          "model",
          "quota"
        ]
      },
      "governance": {
        "description": "Agent rules, branch protection, required checks, project board taxonomy",
        "keywords": [
          "governance",
          "rule",
          "protection",
          "policy",
          "board",
          "taxonomy",
          "label",
          "permission"
        ]
      },
      "release": {
        "description": "Versioning modes, tagging, asset packaging, release notes",
        "keywords": [
          "release",
          "version",
          "versioning",
          "tag",
          "semver",
          "changelog",
          "package",
          "artifact"
        ]
      },
      "docs": {
        "description": "Documentation compiler, TSDoc/API reference, architecture records and shared web documentation surfaces",
        "keywords": [
          "doc",
          "docs",
          "documentation",
          "tsdoc",
          "typedoc",
          "content",
          "readme",
          "site"
        ]
      },
      "ci": {
        "description": "GitHub Actions workflows, containers, runner scripts, repository automation",
        "keywords": [
          "ci",
          "action",
          "workflow",
          "pipeline",
          "docker",
          "runner",
          "automation",
          "container"
        ]
      }
    },
    "accounts": {
      "$comment": "The `df` accounts this repository provisions. `set` rows are [variable, account, slot] for a credential handed to df with `df account set`; `load` rows are [variable, account] for a subscription record df loads itself. Which providers are used, what the accounts are called and which slot each holds are facts about this repository, so they are declared here rather than listed in the code that applies them.",
      "set": [
        [
          "GEMINI_API_KEY",
          "google:default",
          "api_key"
        ],
        [
          "GEMINI_API_KEY_2",
          "google:key2",
          "api_key"
        ],
        [
          "GEMINI_API_KEY_3",
          "google:key3",
          "api_key"
        ],
        [
          "OPENROUTER_API_KEY",
          "openrouter:default",
          "api_key"
        ],
        [
          "OPENROUTER_API_KEY_2",
          "openrouter:acct2",
          "api_key"
        ],
        [
          "GROQ_API_KEY",
          "groq:default",
          "api_key"
        ]
      ],
      "load": [
        [
          "DF_ACCOUNT_OPENAI_CODEX",
          "openai-codex:pipeline"
        ],
        [
          "DF_ACCOUNT_GROK_SUB",
          "grok-sub:pipeline"
        ]
      ]
    },
    "labels": {
      "$comment": "Label vocabularies. Each is data about this repository \u2014 which statuses exist, which conventional-commit types are permitted, which colours area labels take \u2014 so it is declared here rather than as a constant in the code that applies it. The code holds the mechanism, not the list.",
      "area_colours": [
        "5319e7",
        "1f883d",
        "0052cc",
        "a2eeef",
        "f9d0c4",
        "c2e0c6",
        "e99695",
        "006b75",
        "0075ca"
      ],
      "types": [
        "feat",
        "bug",
        "chore",
        "refactor",
        "test",
        "ci",
        "docs"
      ],
      "statuses": [
        "Backlog",
        "ToDo",
        "In Progress",
        "Blocked",
        "Done",
        "Superseded",
        "Dropped"
      ]
    },
    "board": {
      "$comment": "Boards are owned by the account, not by a repository, and there is no fixed number of them. `boards` names every board this repository participates in; the pipeline creates each one that does not exist and links each to the repository. `global` names the one that aggregates every repository, by reference, so it cannot disagree with the list.",
      "global": "Global",
      "boards": [
        "Global",
        "DarkFactory",
        "Omnis",
        "ChessWithQuests"
      ]
    },
    "pages": {
      "$comment": "GitHub Actions publishes the main branch site; no generated branch is retained.",
      "build_type": "workflow",
      "branch": "main",
      "path": "/"
    },
    "app": {
      "$comment": "The pipeline's own GitHub App. The id and client id are public identifiers, not secrets; the private key lives in the DARKFACTORY_APP_PRIVATE_KEY repository secret. Note that a GitHub App cannot write user-owned Projects v2 - GitHub scopes project permissions to organizations - so board work still uses GH_PROJECT_TOKEN until these repositories move under an organization.",
      "slug": "darkfactory-pipeline",
      "app_id": 4861004,
      "client_id": "Iv23li8qwSbe1MpF9kxX",
      "private_key_secret": "DARKFACTORY_APP_PRIVATE_KEY",
      "permissions": {
        "repository": {
          "actions": "write",
          "checks": "write",
          "contents": "write",
          "issues": "write",
          "metadata": "read",
          "pull_requests": "write",
          "workflows": "write"
        },
        "organization": {
          "projects": "write"
        }
      },
      "installation_id": 159771550,
      "installed_on": [
        "marius-patrik/agent-DarkFactory",
        "marius-patrik/omnis",
        "marius-patrik/ChessWithQuests",
        "marius-patrik/OdbornaPrace-paper",
        "marius-patrik/template-OdbornaPrace",
        "marius-patrik/OdbornaPrace-mono"
      ]
    },
