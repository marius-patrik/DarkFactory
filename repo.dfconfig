    "release": {
      "$comment": "Final package/capability distribution and publishing behavior is defined by PRD.md and the release capability. `record_issue` is the Request every `chore(release): record <version>` pull request binds: the release job cannot merge one itself, because `develop` requires a review and only an authorized human may approve, so this is the standing target that keeps the version record inside the governed path.",
      "metadata": "ignore",
      "record_issue": 1113
    }
  },
  "docs": {
    "version": 1,
    "site": {
      "name": "DarkFactory",
      "description": "Autonomous, governed software delivery built around a self-hosting df engine, versioned capabilities and GitHub as the durable control plane."
    },
    "home": "README.md"
  },
  "providers": {
    "cooldownTtlMs": 120000,
    "sensitiveChain": "groq/openai/gpt-oss-120b@default,openai-codex/gpt-5.6-luna@pipeline,grok-sub/grok-4.6@pipeline",
    "router": {
      "policies": [
        {
          "id": "prefer-free-and-space-bunny",
          "match": {
            "sensitivity": [
              "normal"
            ]
          },
          "prefer": {
            "preferModels": [
              "space-bunny"
            ],
            "preferProviders": [
              "opencode-zen",
              "kilo-gateway",
              "groq",
              "openrouter",
              "google",
              "grok-sub",
              "openai-codex"
            ],
            "preferFree": true
          }
        },
        {
          "id": "sensitive",
          "match": {
            "sensitivity": [
              "sensitive"
            ]
          },
          "prefer": {
            "preferFree": false
          }
        }
      ],
      "dataCollection": {
        "sensitive": [
          "none",
          "unknown"
        ]
      }
    }
  }
}
