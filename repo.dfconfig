      },
      "openrouter": {
        "name": "OpenRouter",
        "display_name": "OpenRouter",
        "trailer": null,
        "note": "Generated with {model}",
        "account_link": null,
        "verified": false
      },
      "opencode-zen": {
        "name": "OpenCode Zen",
        "display_name": "OpenCode Zen",
        "trailer": null,
        "note": "Generated with {model}",
        "account_link": null,
        "verified": false
      },
      "kimi": {
        "name": "Kimi",
        "display_name": "Kimi",
        "trailer": null,
        "note": "Generated with {model}",
        "account_link": null,
        "verified": false
      }
    },
    "release": {
      "$comment": "Final package/capability distribution and publishing behavior is defined by PRD.md and the release capability. `record_issue` is the Request every `chore(release): record <version>` pull request binds: the release job cannot merge one itself, because `develop` requires a review and only an authorized human may approve, so this is the standing target that keeps the version record inside the governed path.",
      "metadata": "ignore",
      "record_issue": 1113
    }
  },
  "docs": {
    "version": 1,
    "site": {
      "name": "DarkFactory",
      "description": "Autonomous, governed software delivery built around a self-hosting df engine, versioned capabilities and GitHub as the durable control plane."
    },
    "home": ".agents/PRD.md"
  },
  "providers": {
    "defaultChain": "google/gemini-3.8-flash@default,google/gemini-3.8-flash@key2,google/gemini-3.8-flash@key3,google/gemini-3.7-flash@default,google/gemini-3.7-flash@key2,google/gemini-3.7-flash@key3,google/gemini-3.6-flash@default,google/gemini-3.6-flash@key2,google/gemini-3.6-flash@key3,google/gemini-3.5-flash@default,google/gemini-3.5-flash@key2,google/gemini-3.5-flash@key3,google/gemini-3-flash-preview@default,google/gemini-3-flash-preview@key2,google/gemini-3-flash-preview@key3,google/gemini-3.5-flash-lite@default,google/gemini-3.5-flash-lite@key2,google/gemini-3.5-flash-lite@key3,google/gemini-3.1-flash-lite@default,google/gemini-3.1-flash-lite@key2,google/gemini-3.1-flash-lite@key3,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free@default,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free@acct2,groq/openai/gpt-oss-120b@default,openai-codex/gpt-5.6-luna@pipeline,grok-sub/grok-4.6@pipeline",
    "cooldownTtlMs": 120000,
    "sensitiveChain": "groq/openai/gpt-oss-120b@default,openai-codex/gpt-5.6-luna@pipeline,grok-sub/grok-4.6@pipeline",
    "router": {
      "policies": [],
      "dataCollection": {
        "sensitive": [
          "none",
          "unknown"
        ]
      }
    }
  }
}
