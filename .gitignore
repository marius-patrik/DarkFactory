# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.egg-info/
build/
dist/

# Rust
/target/
**/*.rs.bk

# Node / Bun
node_modules/
.bun/
*.tsbuildinfo

# Tauri
src-tauri/target/

# MkDocs
site/
.properdocs-source/

# Agent pipeline
.darkfactory/generated/

# Agent tooling local state (opencode goal/session bookkeeping)
.opencode/

# Paper build output. This repository no longer has a paper — it moved to
# marius-patrik/DarkFactory-Paper — but the paper capability is generic, so a consumer with a
# manuscript under `paper/` writes here, and committing the intermediate would make a green matrix
# run rewrite a tracked binary.

# Agent worktrees. The folder is tracked through a .gitkeep so it exists in a fresh clone, and
# everything below it is ignored: a checkout is local working state, and there is no path by which
# one should reach a commit.
.worktrees/*
!.worktrees/.gitkeep

# IDE / Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# The runner mounts the webhook payload into the workspace; it is not repository content.
event.json

# uv writes this when Python tooling is invoked; the manifest is pyproject.toml
uv.lock

.licence-test-*/
.cli-test-*/
# The reachability analyser is a working tool, not a deliverable: it is rewritten on every run, so
# its generated JSON can never satisfy a format check.
.ast-reachability.*

paper/out/
