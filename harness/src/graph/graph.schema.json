{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkfactory.dev/schema/workflow-graph-v1.json",
  "title": "DarkFactory workflow graph v1",
  "type": "object",
  "required": ["version", "checks", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["Backlog", "ToDo", "In Progress", "Blocked", "Done", "Superseded", "Dropped"] },
    "check": {
      "type": "object",
      "required": ["name", "required"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" } },
      "additionalProperties": false
    },
    "baseNode": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["agent", "gate", "automation", "check-reference"] },
        "description": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "board_status": { "type": "object", "additionalProperties": { "$ref": "#/$defs/status" } },
        "trigger": {
          "type": "object",
          "properties": { "event": { "type": "string" }, "schedule": { "type": "string" } },
          "additionalProperties": false
        },
        "filter": {
          "type": "object",
          "properties": { "label": { "type": "string" }, "ignore_bots": { "type": "boolean" } },
          "additionalProperties": false
        },
        "foreach": {
          "type": "object",
          "properties": {
            "items": { "type": "string" },
            "max_parallel": { "type": "integer", "minimum": 1 },
            "as": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "node": {
      "allOf": [{ "$ref": "#/$defs/baseNode" }],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "agent" },
            "identity": { "type": "string" },
            "reasoning": { "enum": ["standard", "hard"] },
            "chain": { "type": "array", "items": { "type": "string", "pattern": "^[^/@]+/[^@]+@[^@]+$" } },
            "timeout": { "type": "string" },
            "iteration": {
              "type": "object",
              "required": ["context_file"],
              "properties": {
                "context_file": { "type": "string" },
                "safety_budget": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "quota_policy": {
              "type": "object",
              "required": ["on_exhaustion", "resume"],
              "properties": {
                "on_exhaustion": { "const": "checkpoint_and_block" },
                "resume": { "const": "sweep_or_command" }
              },
              "additionalProperties": false
            },
            "prompt": { "type": "string" },
            "mode": { "enum": ["read", "write"] },
            "workdir": { "type": "string" },
            "max_turns": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "properties": {
            "kind": { "const": "gate" },
            "author_associations": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["OWNER", "MEMBER", "COLLABORATOR", "AUTHOR"] }
            },
            "requester_can_approve": { "type": "boolean" },
            "command": { "const": "^\\s*(?:/df\\s+|/)(?:approve|reject|revise)\\s*$" },
            "allow_review_state": { "type": "array", "items": { "const": "APPROVED" } },
            "reminder_after_days": { "type": "integer", "minimum": 1 },
            "on_reject": {
              "type": "object",
              "required": ["action", "target"],
              "properties": {
                "action": { "enum": ["route_to", "revert_deviation"] },
                "target": { "$ref": "#/$defs/id" }
              },
              "additionalProperties": false
            }
          },
          "required": ["author_associations", "command"]
        },
        {
          "properties": {
            "kind": { "const": "automation" },
            "script": { "type": "string" },
            "side_effects": {
              "type": "object",
              "properties": { "close_bound_issues": { "type": "boolean" }, "clear_checkpoints": { "type": "boolean" } },
              "additionalProperties": false
            }
          },
          "required": ["script"]
        },
        {
          "properties": {
            "kind": { "const": "check-reference" },
            "check": { "type": "string" },
            "required": { "type": "boolean" }
          },
          "required": ["check", "required"]
        }
      ]
    },
    "on": {
      "oneOf": [
        {
          "type": "object",
          "required": ["event", "filter"],
          "properties": {
            "event": { "type": "string" },
            "filter": {
              "type": "object",
              "required": ["ignore_bots"],
              "properties": { "ignore_bots": { "const": true }, "label": { "type": "string" } },
              "additionalProperties": false
            },
            "when": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["schedule"],
          "properties": { "schedule": { "const": true }, "when": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["node_outcome"],
          "properties": {
            "node_outcome": { "enum": ["success", "failure", "quota_exhausted"] },
            "when": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["gate_outcome"],
          "properties": { "gate_outcome": { "enum": ["approved", "rejected"] }, "when": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["checks"],
          "properties": { "checks": { "enum": ["required_green", "failed"] }, "when": { "type": "string" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["children"],
          "properties": { "children": { "enum": ["all_done", "any_failed"] }, "when": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "on"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "on": { "$ref": "#/$defs/on" },
        "loop": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["self_review", "ci_repair", "gate_revision", "deviation_rework"] },
            "safety_budget": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
